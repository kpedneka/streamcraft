# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Go workspace file
go.work
go.work.sum

# Compiled binaries from `go build ./cmd/...` run without -o — these have
# no file extension on macOS/Linux, so *.exe/*.dll above don't catch them.
/bin

# env file
.env*
!.env.example